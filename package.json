{
  "name": "flow-banking-ecosystem",
  "version": "1.0.0",
  "description": "Flow - Digital Banking & Distributed Payment Ecosystem (Monorepo)",
  "private": true,
  "workspaces": [
    "services/*",
    "gateway/*",
    "client/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,proto,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,proto,md}\"",
    "test": "npm run test --workspaces --if-present",
    "dev:gateway": "npm run dev --workspace=gateway/graphql-gateway",
    "dev:wallet": "npm run dev --workspace=services/wallet-service",
    "dev:transaction": "npm run dev --workspace=services/transaction-service",
    "dev:user": "npm run dev --workspace=services/user-service",
    "dev:fraud": "npm run dev --workspace=services/fraud-detection-service",
    "dev:notification": "npm run dev --workspace=services/notification-service",
    "dev:client": "npm run dev --workspace=client/frontend",
    "verify:e2e": "bash scripts/verify-e2e.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "Flow Banking Architecture Team",
  "license": "UNLICENSED"
}
